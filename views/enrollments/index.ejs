<%- include("../partials/header") %>
    <h1>Listado de Matrículas</h1>

    <a href="/matriculas/new" class="btn-primary">+ Nueva Matrícula</a>

    <% if (matriculas.length === 0) { %>
        <p class="vacio">No hay matrículas todavía. Ejecuta <code>npm run seed</code> o crea una nueva.</p>
    <% } else { %>
    <table>
        <thead>
            <tr>
                <th scope="col">Alumno</th>
                <th scope="col">Curso</th>
                <th scope="col">Fecha</th>
                <th scope="col">Estado</th>
                <th scope="col">Notas</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% matriculas.forEach(m => { %>
                <tr>
                    <!-- Gracias al POPULATE, userId y courseId son objetos con sus datos reales -->
                    <td>
                        <% if (m.userId) { %>
                            <a class="enlace-texto" href="/usuarios/<%= m.userId._id %>"><%= m.userId.firstName %> <%= m.userId.lastName %></a>
                            <small><%= m.userId.dni %> · <%= m.userId.profile %></small>
                        <% } else { %>
                            <span class="vacio">Usuario eliminado</span>
                        <% } %>
                    </td>
                    <td>
                        <% if (m.courseId) { %>
                            <a class="enlace-texto" href="/cursos/<%= m.courseId._id %>"><%= m.courseId.title %></a>
                            <small><%= formatearFecha(m.courseId.startDate) %> - <%= formatearFecha(m.courseId.endDate) %></small>
                        <% } else { %>
                            <span class="vacio">Curso eliminado</span>
                        <% } %>
                    </td>
                    <td><%= formatearFecha(m.enrollmentDate) %></td>
                    <td><span class="badge <%= m.status %>"><%= m.status %></span></td>
                    <td><%= m.notes || "-" %></td>
                    <td>
                        <div class="actions-cell">
                            <a href="/matriculas/<%= m.id %>/edit">EDIT</a>
                            <!-- Formulario POST con ?_method=DELETE (method-override) -->
                            <form action="/matriculas/<%= m.id %>?_method=DELETE" method="POST" onsubmit="return confirm('¿Seguro que quieres eliminar esta matrícula?')">
                                <button>DELETE</button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <% } %>

<%- include("../partials/footer") %>
