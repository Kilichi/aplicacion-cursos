<%- include("../partials/header") %>
    <div>
        <div>
            <h1>Detalle del Curso</h1>
            <span><%= curso.id %></span>
        </div>
        <div>
            <div>Título</div>
            <div><%= curso.title %></div>
        </div>
        <div>
            <div>Categoría</div>
            <div><%= curso.category %></div>
        </div>
        <div>
            <div>Descripción</div>
            <div><%= curso.description %></div>
        </div>
        <div>
            <div>Ubicación</div>
            <div><%= curso.location %></div>
        </div>
        <div>
            <div>Fechas</div>
            <div>Del <%= formatearFecha(curso.startDate) %> al <%= formatearFecha(curso.endDate) %></div>
        </div>
        <div>
            <div>Creado / Actualizado</div>
            <div><%= formatearFecha(curso.createdAt) %> / <%= formatearFecha(curso.updatedAt) %></div>
        </div>
        <a href="/cursos/<%= curso.id %>/edit">Editar</a>
        <a href="/cursos">Volver al Listado</a>
    </div>
<%- include("../partials/footer") %>
